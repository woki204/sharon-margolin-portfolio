rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'woki2004@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validCounterShape() {
      return request.resource.data.keys().hasOnly(['count', 'name', 'num'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0;
    }

    match /adminAccess/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /apps/{appId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'favs', 'created'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favs'])
      );
      allow delete: if isAdmin();
    }

    match /clicks/{appId} {
      allow read: if true;
      allow create: if validCounterShape() && request.resource.data.count == 1;
      allow update: if validCounterShape()
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    match /favCounts/{appId} {
      allow read: if true;
      allow create: if validCounterShape()
        && request.resource.data.count == 1;
      allow update: if validCounterShape()
        && (
          request.resource.data.count == resource.data.count + 1
          || request.resource.data.count == resource.data.count - 1
        );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
